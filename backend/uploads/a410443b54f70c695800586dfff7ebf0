#include <iostream>
#include <string>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, k;
        cin >> n >> k;

        string s;
        cin >> s;

        bool possible = true;

        for (int start = 0; start < k; start++) {
            int chainLength = 0;
            int onesCount = 0;

            for (int pos = start; pos < n; pos += k) {
                chainLength++;
                if (s[pos] == '1')
                    onesCount++;
            }

            if (chainLength == 1) {
                if (onesCount == 1) {
                    possible = false;
                    break;
                }
            } else {
                if (onesCount % 2 != 0) {
                    possible = false;
                    break;
                }
            }
        }

        cout << (possible ? "YES" : "NO") << "\n";
    }

    return 0;
}